# CityPulse Environment Variables Configuration Template
# Copy this file to backend/.env and frontend/.env respectively

# Database Connection (Default: local SQLite database, or Supabase PostgreSQL)
DATABASE_URL=sqlite:///./citypulse.db
# Example Supabase Cloud PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT Security
SECRET_KEY=citypulse_super_secret_jwt_key_2026_change_in_prod

# Optional: Google Gemini API Key for Natural Language RAG Operations Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Synthetic Simulation Engine Tick Interval in Seconds
SIMULATION_INTERVAL_SECONDS=3.0
